# Verification locale uniquement, laisser vide dans l'usage normal.
# QA=1 isole la compilation dans .next-territory-qa-webpack.
FEACO_TERRITORY_QA=
# QA=1 + TEST_FIXTURE=1 + NODE_ENV=development : stockage de TEST en memoire.
# Aucun repli automatique vers ce mode. Jamais actif dans un build de production.
FEACO_TERRITORY_TEST_FIXTURE=
# URL facultative du script scripts/verify-territory.cjs (defaut 127.0.0.1:3016).
TERRITORY_TEST_URL=
# Facultatif pour les anciens scripts de verification : chemin du module Playwright.
# PLAYWRIGHT_MODULE=
# Optional: isolated development-only simulated UI page /affiliations-qa. Leave empty normally.
FEACO_AFFILIATIONS_QA=
